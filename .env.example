# ================================================
#  VN Store — Credenciais da API da Nuvemshop
#  Copie este arquivo para .env e preencha.
#  O .env NUNCA vai para o Git (está no .gitignore).
# ================================================

# ID da sua loja na Nuvemshop
NUVEMSHOP_STORE_ID=000000

# Access token do app (trate como uma senha)
NUVEMSHOP_ACCESS_TOKEN=cole_seu_token_aqui

# Identificação obrigatória nas requisições à API
NUVEMSHOP_APP_NAME=VN Store Sistema
NUVEMSHOP_CONTACT_EMAIL=despertatuquedormes33@gmail.com

# Porta do servidor local
PORT=3000
